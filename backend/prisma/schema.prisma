// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                  @id @default(uuid())
  email                 String                  @unique
  password              String
  createdAt             DateTime                @default(now())
  /**
   * Bumped to invalidate every token this user holds. Tokens carry the value
   * they were signed with, so incrementing it makes all of them stale at once
   * — the only way to revoke a stateless JWT before it expires. Changing a
   * password bumps it too, so a stolen token dies with the password.
   */
  tokenVersion          Int                     @default(0)
  profile               UserProfile?
  settings              Settings?
  biometrics            Biometric[]
  workoutSessions       WorkoutSession[]
  muscleFatigueLogs     MuscleFatigueLog[]
  muscleFatigueCurrent  MuscleFatigueCurrent[]
  sleepLogs             SleepLog[]
  nutritionLogs         NutritionLog[]
  chatThreads           ChatThread[]
  notifications         Notification[]
  customExercises       Exercise[]              @relation("CustomExercises")
  pushSubscriptions     PushSubscription[]
  systemicFatigue       SystemicFatigue?
  strengthEstimates     ExerciseStrengthEstimate[]
  aiUsage               AiUsageDaily[]
  notificationPref      NotificationPreference?
  notificationTypePrefs NotificationTypePref[]
  workoutTemplates      WorkoutTemplate[]
  scheduledWorkouts     ScheduledWorkout[]
  aiProposals           AiProposal[]
}

// Notification opt-in. EVERY flag defaults false, and there is no backfill:
// existing users — including anyone who already has a PushSubscription — get
// nothing until they choose it. A subscription is permission to DELIVER, not
// permission to send.
model NotificationPreference {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /** Master switch. Off ⇒ nothing sends, whatever else is set. */
  pushEnabled      Boolean   @default(false)
  /** Rule-driven notifications: readiness, overreaching, inactivity. Never
   *  auto-suspends — the overreaching warning matters most exactly when the
   *  athlete has stopped paying attention. */
  essentialEnabled Boolean   @default(false)
  /** AI-planned coaching nudges. Suspends itself when ignored. */
  coachEnabled     Boolean   @default(false)

  /** IANA zone from the browser. Without it no reminder can be timed to a
   *  local hour, which is why every timed rule depends on this field. */
  timezone         String    @default("UTC")
  /** Local hours. Wraps midnight when start > end, which is the normal case. */
  quietStartHour   Int       @default(22)
  quietEndHour     Int       @default(8)
  /** Hard ceiling the scheduler enforces. The planner proposes; this disposes. */
  dailyCap         Int       @default(3)

  /** Consecutive coach notifications shown but never opened. Only counts ones
   *  confirmed DISPLAYED — a push lost to a flat battery is not disinterest. */
  ignoredStreak    Int       @default(0)
  coachSuspendedAt DateTime?

  /** Last authenticated request from this user. Notifications are suppressed
   *  while they are already in the app — a nudge to train that arrives while
   *  you are mid-set is noise. */
  lastSeenAt       DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Per-type opt-in, also default-off. Absence of a row means "not enabled".
model NotificationTypePref {
  userId  String
  type    String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled Boolean @default(false)

  @@id([userId, type])
}

// Per-day AI spend, so one user cannot run the bill up without limit. Written
// from the provider's own token counts after each call rather than an estimate,
// because prompt size varies with how much history and context a turn carries.
model AiUsageDaily {
  userId       String
  /** UTC calendar day, YYYY-MM-DD. Deliberately a string: the budget resets on
   *  a day boundary and never needs date arithmetic. */
  day          String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  calls        Int      @default(0)
  /** Calls made by the notification planner specifically. Capped separately so
   *  the planner cannot eat the budget the user needs for chatting, and a
   *  re-plan loop cannot run all day. */
  plannerCalls Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  updatedAt    DateTime @updatedAt

  @@id([userId, day])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model UserProfile {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  age         Int?
  weight      Float?
  height      Float?
  gender      String?
  phoneNumber String?
  fitnessLevel String?
  goal        String?
}

model Settings {
  userId                  String   @id
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredUnit           String   @default("metric")
  notificationEnabled     Boolean  @default(true)
  inactivityDaysThreshold Int      @default(3)
  theme                   String   @default("dark")
  aiConsentEnabled        Boolean  @default(true)

  /**
   * Optional screen lock. Bcrypt-hashed like a password — a PIN is short
   * enough to brute force offline if it were ever stored reversibly.
   * Null means the user has not set one.
   */
  pinHash                 String?
  /** Consecutive wrong entries. A 4-digit PIN is 10,000 guesses without this. */
  pinFailedAttempts       Int      @default(0)
  /** Set after too many failures; entry is refused until it passes. */
  pinLockedUntil          DateTime?
}

model Biometric {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  measuredAt DateTime      @default(now())
  type       BiometricType
  value      Float
  source     String        @default("manual")

  @@index([userId, type, measuredAt])
}

enum BiometricType {
  WEIGHT
  BODY_FAT
  LEAN_MASS
  HEART_RATE
  HRV
  SLEEP_SCORE
}

model Muscle {
  id               String                  @id @default(uuid())
  name             String                  @unique
  // Hours for this muscle's fatigue to halve. Small muscles clear far faster
  // than large ones — calves are usable the next day, lower back is not.
  recoveryHalfLifeHours Float              @default(15)
  musclePaths      MusclePath[]
  exerciseLinks    MuscleExercise[]
  fatigueLogs      MuscleFatigueLog[]
  fatigueCurrent   MuscleFatigueCurrent[]
}

model MusclePath {
  id        String  @id @default(uuid())
  muscleId  String
  muscle    Muscle  @relation(fields: [muscleId], references: [id])
  svgPathId String
  pathData  String  @db.Text
  side      String  @default("front")
}

model Modality {
  id        String     @id @default(uuid())
  name      String     @unique
  exercises Exercise[]
}

model ExerciseCategory {
  id            String               @id @default(uuid())
  name          String               @unique
  exerciseLinks ExerciseCategoryMap[]
}

model Exercise {
  id               String               @id @default(uuid())
  name             String
  modalityId       String
  modality         Modality             @relation(fields: [modalityId], references: [id])
  description      String?              @db.Text
  // Mechanical damage per unit of work, relative to a normal barbell lift.
  // Eccentric, weight-bearing and landing-heavy movements tear muscle far more
  // than concentric ones: running ≫ cycling, RDLs ≫ leg press. impactFactor
  // says WHICH muscles a movement uses; this says how hard it is on them.
  damageFactor     Float                @default(1.0)
  // Typical speed for a distance-based activity, used to convert distance
  // covered into comparable work across modalities (15 km cycled is not 15 km
  // run). Null when distance is meaningless for the movement — jump rope,
  // or anything logged on a clock alone — which falls back to duration.
  referenceSpeedKmh Float?
  createdByUserId  String?
  createdByUser    User?                @relation("CustomExercises", fields: [createdByUserId], references: [id])
  muscleLinks      MuscleExercise[]
  categoryLinks    ExerciseCategoryMap[]
  equipmentLinks   EquipmentExercise[]
  media            Media[]
  workoutExercises WorkoutExercise[]
  strengthEstimates ExerciseStrengthEstimate[]
  templateExercises TemplateExercise[]
  @@unique([name])
}

model MuscleExercise {
  muscleId     String
  exerciseId   String
  muscle       Muscle   @relation(fields: [muscleId], references: [id])
  exercise     Exercise @relation(fields: [exerciseId], references: [id])
  impactFactor Float    @default(1.0)

  @@id([muscleId, exerciseId])
}

model ExerciseCategoryMap {
  exerciseId String
  categoryId String
  exercise   Exercise         @relation(fields: [exerciseId], references: [id])
  category   ExerciseCategory @relation(fields: [categoryId], references: [id])

  @@id([exerciseId, categoryId])
}

model Equipment {
  id            String              @id @default(uuid())
  name          String              @unique
  description   String?
  exerciseLinks EquipmentExercise[]
}

model EquipmentExercise {
  equipmentId String
  exerciseId  String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  exercise    Exercise  @relation(fields: [exerciseId], references: [id])
  qtyOptional Int?
  notes       String?

  @@id([equipmentId, exerciseId])
}

model Media {
  id           String   @id @default(uuid())
  exerciseId   String
  exercise     Exercise @relation(fields: [exerciseId], references: [id])
  videoUrl     String?
  thumbnailUrl String?
}

model WorkoutSession {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateTime         DateTime          @default(now())
  duration         Int?
  avgRpe           Float?
  totalVolume      Float?
  // Session training load in arbitrary units (Foster's sRPE: minutes × RPE,
  // weighted by how cardiovascularly costly the modality mix is). This is the
  // whole-body cost of the session — totalVolume only covers mechanical kg.
  systemicLoad     Float?
  weatherCondition String?
  notes            String?
  // Which saved plan this session came from, when it came from one. Kept so
  // "do it again" can compare like against like, and so a template's
  // performance history is its own sessions rather than everything the athlete
  // happened to train that day.
  templateId       String?
  template         WorkoutTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  workoutExercises WorkoutExercise[]
  fatigueLogs      MuscleFatigueLog[]
  scheduled        ScheduledWorkout?

  @@index([userId, dateTime])
  @@index([templateId])
}

model WorkoutExercise {
  id        String         @id @default(uuid())
  sessionId String
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise  Exercise       @relation(fields: [exerciseId], references: [id])
  orderIndex Int
  notes     String?
  sets      WorkoutSet[]

  @@index([sessionId])
  @@index([exerciseId])
}

model WorkoutSet {
  id                 String            @id @default(uuid())
  workoutExerciseId  String
  workoutExercise    WorkoutExercise   @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setNumber          Int
  setType            SetType
  rpe                Float?
  restSeconds        Int?
  strength           SetStrength?
  calisthenics       SetCalisthenics?
  cardio             SetCardio?
  wod                SetWOD?
  mobility           SetMobility?
  runTrack           RunTrack?

  @@index([workoutExerciseId])
  // One row per set of an exercise — re-logging corrects the set in place
  // rather than appending a duplicate that double-counts volume and fatigue.
  @@unique([workoutExerciseId, setNumber])
}

enum SetType {
  STRENGTH
  CALISTHENICS
  CARDIO
  WOD
  MOBILITY
}

model SetStrength {
  setId  String     @id
  set    WorkoutSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  reps   Int
  weight Float
}

model SetCalisthenics {
  setId       String     @id
  set         WorkoutSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  reps        Int
  addedWeight Float      @default(0)
  // Seconds under tension for isometric holds (plank, L-sit, front lever…),
  // which have no meaningful rep count. Null for normal rep-based sets.
  time        Int?
}

model SetCardio {
  setId    String     @id
  set      WorkoutSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  distance Float?
  time     Int?
}

/// Everything a GPS session recorded beyond its distance and its clock.
///
/// Split out from SetCardio rather than added to it because of `route`, which
/// is a few tens of kilobytes for a long run. The calendar lists every set of
/// every session, and SetCardio is loaded with all of them — dragging a route
/// along for each would make the month view pay for maps it never draws. One
/// row per cardio set, fetched only when a run is actually opened.
model RunTrack {
  setId          String     @id
  set            WorkoutSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  /// When the clock was started, which is not when the set was written — an
  /// effort rating can sit on screen for minutes after a run ends.
  startedAt      DateTime
  /// Metres, unrounded. SetCardio.distance is kilometres rounded to two
  /// decimals for display; pace derived from that is off by seconds.
  distanceM      Float
  durationSec    Int
  /// Seconds per kilometre. Stored rather than derived so the number in history
  /// is the one the athlete saw when they finished.
  avgPaceSec     Int
  elevationGainM Int        @default(0)
  /// 'gps' | 'manual' — a manual session has splits but no route.
  source         String     @default("gps")
  /// [[[lng, lat], …], …] — one array per stretch of continuous recording.
  /// Segmented at write time so nothing downstream can draw a straight line
  /// across a gap the app was not running for.
  route          Json?
  /// [[west, south], [east, north]], for framing the map without parsing route.
  bounds         Json?
  /// Kilometre splits: [{ index, meters, seconds, endMeters, auto }]
  splits         Json?
  /// Laps the athlete marked by hand, same shape.
  laps           Json?
  createdAt      DateTime   @default(now())
}

model SetWOD {
  setId    String     @id
  set      WorkoutSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  distance Float?
  time     Int?
  // Reps of THIS movement per round, and rounds completed by the athlete.
  // Both were discarded before, so a 3-round and a 15-round metcon of the same
  // duration scored identically.
  reps     Int?
  rounds   Float?
}

model SetMobility {
  setId String     @id
  set   WorkoutSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  time  Int?
}

model MuscleFatigueCurrent {
  userId           String
  muscleId         String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscle           Muscle    @relation(fields: [muscleId], references: [id])
  fatigueLevel     Float     @default(0)
  updatedAt        DateTime  @updatedAt
  recoveryTargetAt DateTime?

  @@id([userId, muscleId])
}

// Whole-body fatigue, distinct from any single muscle. A long run leaves every
// muscle rating fine while the athlete is wrecked; readiness reads this too.
model SystemicFatigue {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  level            Float     @default(0)
  updatedAt        DateTime  @updatedAt
  recoveryTargetAt DateTime?
}

// Rolling best estimated 1RM per user + exercise. Fatigue scoring needs load
// RELATIVE to what the athlete can lift — 100 kg is a warm-up for one person
// and a limit single for another.
model ExerciseStrengthEstimate {
  userId     String
  exerciseId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  e1rm       Float
  updatedAt  DateTime @updatedAt

  @@id([userId, exerciseId])
}

model MuscleFatigueLog {
  id               String         @id @default(uuid())
  userId           String
  muscleId         String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscle           Muscle         @relation(fields: [muscleId], references: [id])
  source           String         @default("workout")
  delta            Float
  fatigueLevelAfter Float
  createdAt        DateTime       @default(now())
  workoutSessionId String?
  workoutSession   WorkoutSession? @relation(fields: [workoutSessionId], references: [id])

  @@index([userId])
  @@index([workoutSessionId])
}

model SleepLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sleepDate  DateTime
  durationMin Int
  sleepScore Float?
  notes      String?

  @@index([userId, sleepDate])
}

model NutritionLog {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logDate  DateTime
  proteinG Float?
  calories Float?
  notes    String?

  @@index([userId, logDate])
}

model ChatThread {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  messages  AIChat[]

  @@index([userId])
}

model AIChat {
  id        String     @id @default(uuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  messageText String   @db.Text
  sender    String
  dateTime  DateTime   @default(now())

  @@index([threadId, dateTime])
}

// One row is a notification's entire life: planned → sent → displayed → clicked.
//
// Everything reads off this table — the daily cap, per-type cooldowns, dedupe,
// ghost-subscription detection, the coach's engagement streak, and the history
// screen. It is also the only honest record of what actually reached the phone:
// a push service accepting a payload says nothing about delivery, so `sentAt`
// and `displayedAt` mean genuinely different things.
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  /** planned | sent | displayed | clicked | dismissed | failed */
  status    String   @default("planned")
  /** essential | coach */
  tier      String   @default("essential")
  /** rule | ai — whether a rule or the planner produced the wording */
  source    String   @default("rule")

  /** Blocks the same nudge repeating. Typically type + local day. */
  dedupeKey String?
  /** When the scheduler should send it. Null ⇒ send on the next tick. */
  plannedFor DateTime?

  createdAt DateTime @default(now())
  /** Handed to the push service and accepted. NOT proof of delivery. */
  sentAt      DateTime?
  /** The service worker confirmed it rendered. This is the delivery receipt. */
  displayedAt DateTime?
  clickedAt   DateTime?
  dismissedAt DateTime?
  /** Why a send failed, when it did */
  failReason  String?

  @@unique([userId, dedupeKey])
  @@index([userId, status, plannedFor])
}
// ── saved plans ───────────────────────────────────────────────────────────

/**
 * A workout the athlete intends to do, as opposed to one they did.
 *
 * The distinction the rest of the schema was missing. A WorkoutSession is a
 * record of the past and everything downstream — fatigue, training load, the
 * progression suggestions — is derived from it, so it must stay a factual log.
 * A template is an intention: editable, repeatable, and carrying no training
 * load of its own until a session is actually run from it.
 */
model WorkoutTemplate {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  notes       String?
  /** user | ai — an AI-drafted plan stays labelled as one for its whole life. */
  source      String   @default("user")

  /**
   * Archived rather than deleted. A template that produced sessions is part of
   * the explanation for how the athlete got here; deleting it would strand
   * those sessions' templateId and quietly rewrite that history.
   */
  archivedAt      DateTime?
  lastPerformedAt DateTime?
  timesPerformed  Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exercises   TemplateExercise[]
  scheduled   ScheduledWorkout[]
  sessions    WorkoutSession[]

  @@index([userId, archivedAt])
}

model TemplateExercise {
  id         String          @id @default(uuid())
  templateId String
  template   WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise        @relation(fields: [exerciseId], references: [id])
  orderIndex Int
  notes      String?
  sets       TemplateSet[]

  @@index([templateId])
  @@index([exerciseId])
}

/**
 * One planned set. Deliberately flat rather than mirroring the five-table
 * SetType split of WorkoutSet: a plan is a target, and the modality-specific
 * columns a target needs are few enough that a join per modality buys nothing.
 */
model TemplateSet {
  id                 String           @id @default(uuid())
  templateExerciseId String
  templateExercise   TemplateExercise @relation(fields: [templateExerciseId], references: [id], onDelete: Cascade)
  setNumber          Int
  reps               Int?
  weight             Float?
  rpe                Float?
  restSeconds        Int?
  /** Cardio / WOD targets. */
  distance           Float?
  time               Int?
  rounds             Float?

  @@unique([templateExerciseId, setNumber])
}

/**
 * A template placed on a date — the "standby" state.
 *
 * The reminder is not stored here as a time to fire. It creates a row in
 * Notification, which is the one table that already knows about quiet hours,
 * daily caps, dedupe and delivery receipts. Two schedulers writing to a phone
 * is how a user ends up with duplicate nudges at 6am.
 */
model ScheduledWorkout {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId   String
  template     WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  scheduledFor DateTime
  reminderAt   DateTime?
  /** The Notification row backing the reminder, so cancelling can withdraw it. */
  notificationId String?

  /** standby | started | completed | skipped | cancelled */
  status       String          @default("standby")

  /** Set once this becomes a real session. One session per scheduled slot. */
  sessionId    String?         @unique
  session      WorkoutSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  completedAt  DateTime?

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId, status, scheduledFor])
}

/**
 * Something the AI has drafted and the athlete has not yet accepted.
 *
 * The model never writes to the app's own tables. It writes here, and a row
 * here does nothing until a request carrying the user's own session confirms
 * it. That is what keeps a hallucinated 300kg squat or an invented meal out of
 * the training log: the only path from model output to real data runs through
 * a tap, and the payload that gets applied is the one that was shown.
 */
model AiProposal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId  String?
  /**
   * The assistant message this was drafted alongside, so reopening a thread
   * shows the card attached to the reply that produced it rather than floating
   * at the end of the conversation.
   */
  messageId String?
  /** create_template | schedule_workout — what applying this row would do. */
  kind      String
  /** The validated, ID-resolved draft. Applied verbatim on confirm. */
  payload   Json
  /** pending | applied | rejected | expired */
  status    String   @default("pending")
  /**
   * Stale drafts must not be applicable. A card scrolled past on Monday and
   * tapped on Thursday would schedule a workout reasoned about a body state
   * three days gone.
   */
  expiresAt DateTime
  appliedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, status])
}
