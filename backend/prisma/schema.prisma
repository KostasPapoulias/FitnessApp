// SomaTrack database schema (PostgreSQL). Migrations are hand-written; see CLAUDE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                  @id @default(uuid())
  email                 String                  @unique
  password              String
  createdAt             DateTime                @default(now())
  /** Bumped to revoke every token the user holds (see token-version.service). */
  tokenVersion          Int                     @default(0)
  profile               UserProfile?
  settings              Settings?
  biometrics            Biometric[]
  workoutSessions       WorkoutSession[]
  muscleFatigueLogs     MuscleFatigueLog[]
  muscleFatigueCurrent  MuscleFatigueCurrent[]
  sleepLogs             SleepLog[]
  nutritionLogs         NutritionLog[]
  chatThreads           ChatThread[]
  notifications         Notification[]
  customExercises       Exercise[]              @relation("CustomExercises")
  pushSubscriptions     PushSubscription[]
  systemicFatigue       SystemicFatigue?
  strengthEstimates     ExerciseStrengthEstimate[]
  aiUsage               AiUsageDaily[]
  notificationPref      NotificationPreference?
  notificationTypePrefs NotificationTypePref[]
  workoutTemplates      WorkoutTemplate[]
  scheduledWorkouts     ScheduledWorkout[]
  aiProposals           AiProposal[]
  passwordResets        PasswordResetToken[]
  favoriteExercises     FavoriteExercise[]
}

/** A "forgot password" link. Only the token's hash is stored; rows are kept after use so a spent link stays detectable. */
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** SHA-256 of the emailed token. */
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  /** Requesting IP. */
  requestIp String?

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// Notification opt-in. Every flag defaults false: a push subscription is
// permission to deliver, not permission to send.
model NotificationPreference {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /** Master switch. */
  pushEnabled      Boolean   @default(false)
  /** Rule-driven notifications (readiness, overreaching, inactivity). Never auto-suspends. */
  essentialEnabled Boolean   @default(false)
  /** AI-planned coaching nudges. Suspends itself when ignored. */
  coachEnabled     Boolean   @default(false)

  /** IANA zone, needed to time anything to a local hour. */
  timezone         String    @default("UTC")
  /** Local hours; wraps midnight when start > end. */
  quietStartHour   Int       @default(22)
  quietEndHour     Int       @default(8)
  /** Max notifications per rolling 24 h. */
  dailyCap         Int       @default(3)

  /** Consecutive coach notifications displayed but never opened. */
  ignoredStreak    Int       @default(0)
  coachSuspendedAt DateTime?

  /** Last authenticated request; notifications are suppressed while the user is active. */
  lastSeenAt       DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Per-type opt-in; no row means "follow the tier".
model NotificationTypePref {
  userId  String
  type    String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled Boolean @default(false)

  @@id([userId, type])
}

// Per-user, per-day AI usage and cost, from the provider's own token counts.
model AiUsageDaily {
  userId       String
  /** UTC day, YYYY-MM-DD. */
  day          String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  calls        Int      @default(0)
  /** Notification-planner calls, capped separately from chat. */
  plannerCalls Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  updatedAt    DateTime @updatedAt

  @@id([userId, day])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model UserProfile {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  /** Superseded by birthDate; read only as a fallback. */
  age         Int?
  weight      Float?
  height      Float?
  gender      String?
  phoneNumber String?
  fitnessLevel String?
  goal        String?

  birthDate           DateTime?
  /** Self-reported sessions per week. */
  trainingDaysPerWeek Int?
  /** Years of training (fractional). */
  experienceYears     Float?

  /** The onboarding gate: null redirects the app to /onboarding. */
  onboardingCompletedAt DateTime?
  /** Set when the optional equipment/injury stage is answered; controls the Home prompt only. */
  optionalStageDoneAt   DateTime?

  equipment   UserEquipment[]
  injuries    UserInjury[]
}

// Equipment the athlete has. No rows means "unanswered", never "owns nothing".
model UserEquipment {
  userId      String
  equipmentId String
  profile     UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  equipment   Equipment   @relation(fields: [equipmentId], references: [id])
  createdAt   DateTime    @default(now())

  @@id([userId, equipmentId])
}

// A body area to train around. Filters and flags exercises; never feeds fatigue.
model UserInjury {
  id         String    @id @default(uuid())
  userId     String
  profile    UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  /** Null when the limitation does not map to a catalogued muscle. */
  muscleId   String?
  muscle     Muscle?   @relation(fields: [muscleId], references: [id])
  label      String
  /** 'avoid' hides matching exercises; 'caution' flags them. */
  severity   String    @default("caution")
  activeFrom DateTime  @default(now())
  resolvedAt DateTime?

  @@index([userId, resolvedAt])
}

model Settings {
  userId                  String   @id
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredUnit           String   @default("metric")
  notificationEnabled     Boolean  @default(true)
  inactivityDaysThreshold Int      @default(3)
  theme                   String   @default("dark")
  aiConsentEnabled        Boolean  @default(true)

  /** 'en' | 'el'. Used for messages sent with no request in flight (push, AI coach). */
  language                String   @default("en")

  /** Optional screen-lock PIN, bcrypt-hashed. Null when not set. */
  pinHash                 String?
  /** Consecutive wrong PIN entries. */
  pinFailedAttempts       Int      @default(0)
  /** PIN entry refused until this passes. */
  pinLockedUntil          DateTime?
}

model Biometric {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  measuredAt DateTime      @default(now())
  type       BiometricType
  value      Float
  source     String        @default("manual")

  @@index([userId, type, measuredAt])
}

enum BiometricType {
  WEIGHT
  BODY_FAT
  LEAN_MASS
  HEART_RATE
  HRV
  SLEEP_SCORE
}

model Muscle {
  id               String                  @id @default(uuid())
  name             String                  @unique
  // Hours for this muscle's fatigue to halve.
  recoveryHalfLifeHours Float              @default(15)
  musclePaths      MusclePath[]
  exerciseLinks    MuscleExercise[]
  fatigueLogs      MuscleFatigueLog[]
  fatigueCurrent   MuscleFatigueCurrent[]
  injuries         UserInjury[]
}

model MusclePath {
  id        String  @id @default(uuid())
  muscleId  String
  muscle    Muscle  @relation(fields: [muscleId], references: [id])
  svgPathId String
  pathData  String  @db.Text
  side      String  @default("front")
}

model Modality {
  id        String     @id @default(uuid())
  name      String     @unique
  exercises Exercise[]
}

model ExerciseCategory {
  id            String               @id @default(uuid())
  name          String               @unique
  exerciseLinks ExerciseCategoryMap[]
}

model Exercise {
  id               String               @id @default(uuid())
  name             String
  modalityId       String
  modality         Modality             @relation(fields: [modalityId], references: [id])
  description      String?              @db.Text
  // Mechanical damage per unit of work, relative to a normal barbell lift
  // (eccentric and impact-heavy movements are higher).
  damageFactor     Float                @default(1.0)
  // Typical speed, to convert distance into comparable work. Null when distance
  // is meaningless for the movement.
  referenceSpeedKmh Float?
  // What measures the movement and shapes the cardio screen: 'gps' (map),
  // 'machine' (pace, no route) or 'reps' (counted). Independent of referenceSpeedKmh.
  cardioTracking   String               @default("gps")
  // Typical cadence (counts/min) for a 'reps' movement, to convert counts into work.
  referenceCadenceRpm Float?
  // What the count is called ('skips', 'floors'); wording only.
  repUnit          String?
  // Working load for ~10 reps as a fraction of bodyweight (trained adult male
  // reference), used for first-time weight suggestions. Null when unloaded.
  loadFactor       Float?
  createdByUserId  String?
  createdByUser    User?                @relation("CustomExercises", fields: [createdByUserId], references: [id])
  muscleLinks      MuscleExercise[]
  categoryLinks    ExerciseCategoryMap[]
  equipmentLinks   EquipmentExercise[]
  media            Media[]
  workoutExercises WorkoutExercise[]
  strengthEstimates ExerciseStrengthEstimate[]
  templateExercises TemplateExercise[]
  favoritedBy      FavoriteExercise[]
  @@unique([name])
}

// A starred exercise. The composite key makes starring idempotent.
model FavoriteExercise {
  userId     String
  exerciseId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, exerciseId])
  @@index([userId])
}

model MuscleExercise {
  muscleId     String
  exerciseId   String
  muscle       Muscle   @relation(fields: [muscleId], references: [id])
  exercise     Exercise @relation(fields: [exerciseId], references: [id])
  impactFactor Float    @default(1.0)

  @@id([muscleId, exerciseId])
}

model ExerciseCategoryMap {
  exerciseId String
  categoryId String
  exercise   Exercise         @relation(fields: [exerciseId], references: [id])
  category   ExerciseCategory @relation(fields: [categoryId], references: [id])

  @@id([exerciseId, categoryId])
}

model Equipment {
  id            String              @id @default(uuid())
  name          String              @unique
  description   String?
  exerciseLinks EquipmentExercise[]
  userLinks     UserEquipment[]
}

model EquipmentExercise {
  equipmentId String
  exerciseId  String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  exercise    Exercise  @relation(fields: [exerciseId], references: [id])
  qtyOptional Int?
  notes       String?

  @@id([equipmentId, exerciseId])
}

model Media {
  id           String   @id @default(uuid())
  exerciseId   String
  exercise     Exercise @relation(fields: [exerciseId], references: [id])
  videoUrl     String?
  thumbnailUrl String?
}

model WorkoutSession {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateTime         DateTime          @default(now())
  duration         Int?
  avgRpe           Float?
  totalVolume      Float?
  // Whole-body training load (Foster's sRPE, weighted by modality mix).
  systemicLoad     Float?
  weatherCondition String?
  notes            String?
  // The saved plan this session came from, if any.
  templateId       String?
  template         WorkoutTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  workoutExercises WorkoutExercise[]
  fatigueLogs      MuscleFatigueLog[]
  scheduled        ScheduledWorkout?

  @@index([userId, dateTime])
  @@index([templateId])
}

model WorkoutExercise {
  id        String         @id @default(uuid())
  sessionId String
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise  Exercise       @relation(fields: [exerciseId], references: [id])
  orderIndex Int
  notes     String?
  sets      WorkoutSet[]

  @@index([sessionId])
  @@index([exerciseId])
}

model WorkoutSet {
  id                 String            @id @default(uuid())
  workoutExerciseId  String
  workoutExercise    WorkoutExercise   @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setNumber          Int
  setType            SetType
  rpe                Float?
  restSeconds        Int?
  strength           SetStrength?
  calisthenics       SetCalisthenics?
  cardio             SetCardio?
  wod                SetWOD?
  mobility           SetMobility?
  runTrack           RunTrack?

  @@index([workoutExerciseId])
  // One row per set: re-logging corrects the set in place.
  @@unique([workoutExerciseId, setNumber])
}

enum SetType {
  STRENGTH
  CALISTHENICS
  CARDIO
  WOD
  MOBILITY
}

model SetStrength {
  setId  String     @id
  set    WorkoutSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  reps   Int
  weight Float
}

model SetCalisthenics {
  setId       String     @id
  set         WorkoutSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  reps        Int
  addedWeight Float      @default(0)
  // Seconds under tension for isometric holds; null for rep-based sets.
  time        Int?
}

model SetCardio {
  setId    String     @id
  set      WorkoutSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  distance Float?
  time     Int?
  /// Counted work for movements with no distance (skips, floors). Optional.
  reps     Int?
}

/// A recorded run's detail. Separate from SetCardio so the route is only loaded when a run is opened.
model RunTrack {
  setId          String     @id
  set            WorkoutSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  /// When the clock started.
  startedAt      DateTime
  /// Metres, unrounded.
  distanceM      Float
  durationSec    Int
  /// Seconds per kilometre, as shown at finish.
  avgPaceSec     Int
  elevationGainM Int        @default(0)
  /// 'gps' | 'manual' (splits but no route).
  source         String     @default("gps")
  /// [[[lng, lat], …], …] — one array per continuous recording segment.
  route          Json?
  /// [[west, south], [east, north]], for framing the map.
  bounds         Json?
  /// Kilometre splits: [{ index, meters, seconds, endMeters, auto }]
  splits         Json?
  /// Manual laps, same shape.
  laps           Json?
  createdAt      DateTime   @default(now())
}

model SetWOD {
  setId    String     @id
  set      WorkoutSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  distance Float?
  time     Int?
  // Reps of this movement per round, and rounds completed.
  reps     Int?
  rounds   Float?
  // External load in kg (null/0 = bodyweight). Never negative.
  weight   Float?
}

model SetMobility {
  setId String     @id
  set   WorkoutSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  time  Int?
}

model MuscleFatigueCurrent {
  userId           String
  muscleId         String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscle           Muscle    @relation(fields: [muscleId], references: [id])
  fatigueLevel     Float     @default(0)
  updatedAt        DateTime  @updatedAt
  recoveryTargetAt DateTime?

  @@id([userId, muscleId])
}

// Whole-body fatigue, separate from any muscle; readiness reads it too.
model SystemicFatigue {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  level            Float     @default(0)
  updatedAt        DateTime  @updatedAt
  recoveryTargetAt DateTime?
}

// Best estimated 1RM per user and exercise, for relative-load scoring.
model ExerciseStrengthEstimate {
  userId     String
  exerciseId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  e1rm       Float
  updatedAt  DateTime @updatedAt

  @@id([userId, exerciseId])
}

model MuscleFatigueLog {
  id               String         @id @default(uuid())
  userId           String
  muscleId         String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscle           Muscle         @relation(fields: [muscleId], references: [id])
  source           String         @default("workout")
  delta            Float
  fatigueLevelAfter Float
  createdAt        DateTime       @default(now())
  workoutSessionId String?
  workoutSession   WorkoutSession? @relation(fields: [workoutSessionId], references: [id])

  @@index([userId])
  @@index([workoutSessionId])
}

model SleepLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sleepDate  DateTime
  durationMin Int
  sleepScore Float?
  notes      String?

  @@index([userId, sleepDate])
}

model NutritionLog {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logDate  DateTime
  proteinG Float?
  calories Float?
  notes    String?

  @@index([userId, logDate])
}

model ChatThread {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  messages  AIChat[]

  @@index([userId])
}

model AIChat {
  id        String     @id @default(uuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  messageText String   @db.Text
  sender    String
  dateTime  DateTime   @default(now())

  @@index([threadId, dateTime])
}

// A notification's whole life (planned → sent → displayed → clicked). The daily
// cap, cooldowns, dedupe, ghost detection and engagement all read this table.
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  /** planned | sent | displayed | clicked | dismissed | failed */
  status    String   @default("planned")
  /** essential | coach */
  tier      String   @default("essential")
  /** rule | ai */
  source    String   @default("rule")

  /** Blocks repeats; typically type + local day. */
  dedupeKey String?
  /** When to send; null means the next tick. */
  plannedFor DateTime?

  createdAt DateTime @default(now())
  /** Accepted by the push service — not proof of delivery. */
  sentAt      DateTime?
  /** Rendered on the device (the delivery receipt). */
  displayedAt DateTime?
  clickedAt   DateTime?
  dismissedAt DateTime?
  /** Why a send failed. */
  failReason  String?

  @@unique([userId, dedupeKey])
  @@index([userId, status, plannedFor])
}
// ── saved plans ───────────────────────────────────────────────────────────

/** A saved workout plan — an intention, carrying no training load until performed. */
model WorkoutTemplate {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  notes       String?
  /** user | ai */
  source      String   @default("user")

  /** Archived rather than deleted, so sessions keep their templateId. */
  archivedAt      DateTime?
  lastPerformedAt DateTime?
  timesPerformed  Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exercises   TemplateExercise[]
  scheduled   ScheduledWorkout[]
  sessions    WorkoutSession[]

  @@index([userId, archivedAt])
}

model TemplateExercise {
  id         String          @id @default(uuid())
  templateId String
  template   WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise        @relation(fields: [exerciseId], references: [id])
  orderIndex Int
  notes      String?
  sets       TemplateSet[]

  @@index([templateId])
  @@index([exerciseId])
}

/** One planned set; flat, unlike the per-modality tables of WorkoutSet. */
model TemplateSet {
  id                 String           @id @default(uuid())
  templateExerciseId String
  templateExercise   TemplateExercise @relation(fields: [templateExerciseId], references: [id], onDelete: Cascade)
  setNumber          Int
  reps               Int?
  weight             Float?
  rpe                Float?
  restSeconds        Int?
  /** Cardio / WOD targets. */
  distance           Float?
  time               Int?
  rounds             Float?

  @@unique([templateExerciseId, setNumber])
}

/** A template on a date (standby). Its reminder is a planned Notification row. */
model ScheduledWorkout {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId   String
  template     WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  scheduledFor DateTime
  reminderAt   DateTime?
  /** The reminder's Notification row, so cancelling can withdraw it. */
  notificationId String?

  /** standby | started | completed | skipped | cancelled */
  status       String          @default("standby")

  /** The session fulfilling this slot. */
  sessionId    String?         @unique
  session      WorkoutSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  completedAt  DateTime?

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId, status, scheduledFor])
}

/**
 * An AI-drafted change awaiting the athlete's tap. Nothing is applied until a
 * request with the user's own token accepts it, and the stored payload is what
 * gets applied.
 */
model AiProposal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId  String?
  /** The assistant message the card belongs to. */
  messageId String?
  /** create_template | schedule_workout | create_exercise */
  kind      String
  /** The validated draft, applied verbatim on accept. */
  payload   Json
  /** pending | applied | rejected | expired */
  status    String   @default("pending")
  /** Drafts expire, so a stale card cannot be applied. */
  expiresAt DateTime
  appliedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, status])
}
