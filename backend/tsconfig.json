{
  "compilerOptions": {
    "target": "ES2020",
    // node16 rather than commonjs + "node": that pair is deprecated in
    // TypeScript 6, which is what VS Code bundles, so the editor flagged this
    // file as an error while the project's own 5.x compiled it silently. With
    // "type": "commonjs" in package.json node16 still emits CommonJS — the
    // compiled dist/ was diffed before and after and came out byte-identical.
    "module": "node16",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*"],
  // Tests are run through tsx, never compiled into dist. `tsconfig.test.json`
  // is what typechecks them — this file is the build.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
