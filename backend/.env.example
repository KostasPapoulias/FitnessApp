# SomaTrack backend environment.
#
# Copy to `.env` and fill in. `lib/env.ts` refuses to start without the two
# marked REQUIRED — deliberately, because the pattern it replaced was
# `process.env.JWT_SECRET || 'secret'`, which did not fail. It signed every
# token with a guessable string while the app behaved completely normally.
#
# Everything else has a working default or degrades to a disabled feature, so a
# fresh checkout with only the required pair set will boot and run.

# ─── REQUIRED ───────────────────────────────────────────────────────────────

# Postgres. The dev database is remote (Railway), which is why batching queries
# with Promise.all matters so much — see CLAUDE.md.
DATABASE_URL="postgresql://user:password@host:5432/somatrack"

# Signing key for JWTs. Minimum 32 characters; a shorter one is brute-forceable
# offline. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# ─── Server ─────────────────────────────────────────────────────────────────

PORT=3001

# `production` switches CORS to the deployed origin, hides error detail in API
# responses, and makes the logger emit JSON instead of human-readable lines.
NODE_ENV=development

# How long an issued token stays valid.
JWT_EXPIRES_IN=7d

# Where the app is served from. Used to build links that arrive by email, and
# read from configuration rather than from the request's Host header — a reset
# link built from an attacker-supplied Host is the classic host header
# injection. Defaults to localhost:5173 in development.
APP_BASE_URL="http://localhost:5173"

# ─── Observability ──────────────────────────────────────────────────────────

# debug | info | warn | error. Defaults to `debug` in development and `info` in
# production, where `debug` on a request-per-second API is mostly noise and
# Railway bills for log volume.
LOG_LEVEL=debug

# Sentry project DSN. Leave EMPTY in development — with no DSN the reporter is
# a no-op and nothing about the app changes. Setting it is what turns "a 500 is
# discovered when a user complains" into an alert.
SENTRY_DSN=""

# ─── AI coach ───────────────────────────────────────────────────────────────

# Without a key the coach endpoints fail; nothing else is affected.
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-2.0-flash

# Spend ceiling per user per day, in USD. The budget service refuses calls past
# it rather than letting one conversation run up a bill.
AI_DAILY_BUDGET_USD=0.25
AI_RATE_LIMIT_PER_MIN=10
AI_PLANNER_CALLS_PER_DAY=4

# Token prices used to estimate spend against the budget above. Update these
# when the model's pricing changes, or the budget silently stops meaning what
# it says.
AI_PRICE_INPUT_PER_M=0.10
AI_PRICE_OUTPUT_PER_M=0.40

# ─── Push notifications ─────────────────────────────────────────────────────

# VAPID keypair. Without it push is disabled and the app says so at startup
# rather than failing per-send. Generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Must be a mailto: or https: URL — push services reject anything else.
VAPID_SUBJECT="mailto:you@example.com"

# The scheduler is what actually decides to send. Off means subscriptions are
# still accepted and nothing is ever delivered, which is the right default for
# a second developer machine — two schedulers against one database would send
# everything twice.
NOTIFICATION_SCHEDULER_ENABLED=false
NOTIFICATION_TICK_MS=60000

# ─── Email ──────────────────────────────────────────────────────────────────

# Password reset only. With no key, /auth/forgot-password answers 503 and says
# so, rather than telling every user their link is on its way.
RESEND_API_KEY=""
MAIL_FROM="SomaTrack <noreply@example.com>"

# ─── Maps ───────────────────────────────────────────────────────────────────

# Served to the client by /api/config/map rather than baked into the bundle, so
# it can be rotated without a frontend rebuild. Restrict the key to your own
# origins in MapTiler — that is the control that actually protects the quota.
MAPTILER_API_KEY=""
MAPTILER_STYLE=outdoor-v2

# ─── Housekeeping ───────────────────────────────────────────────────────────

# How long a session may sit unfinished before the sweeper clears it.
ABANDONED_SESSION_HOURS=12
