# SomaTrack frontend environment.
#
# Copy to `.env` (or `.env.local`) and fill in. Only variables prefixed with
# VITE_ reach the browser — anything else is dropped by Vite at build time, and
# anything here IS public: it is inlined into the bundle, so no secret belongs
# in this file. Server-side keys live in `backend/.env`, and the map key is
# fetched at runtime from /api/config/map for exactly that reason.

# Where the API lives, including the /api prefix. Defaults to
# http://localhost:3001/api when unset, which is the local backend.
VITE_API_URL="http://localhost:3001/api"
